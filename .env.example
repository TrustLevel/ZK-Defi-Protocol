# ============================================================================
# ZK Private-Lending Protocol — environment template
# Copy to .env and fill in your own values. NEVER commit the real .env.
# ============================================================================

# Cardano network (the deployed v5 validators live on Preprod)
NETWORK=preprod

# Blockfrost Preprod project id (get one at https://blockfrost.io)
# Used by offchain/cli/v5 to submit and query transactions.
PREPROD_BLOCKFROST_API_KEY=preprod_your_blockfrost_project_id_here

# Admin wallet mnemonic (24 words) used to sign the v5 CLI transactions.
# CRITICAL: keep this secret. Fund it with test ADA from the Preprod faucet.
ADMIN_WALLET_SEED=your 24-word mnemonic here
