# SITE_ADDRESS: a domain (preview.example.org) for automatic HTTPS, or ":80"
# (default) for plain HTTP on a local machine. No access log is written, and the
# error log (e.g. a 502 while the backend starts) is kept free of the client's
# address, port and headers.
{
	# Behind a host-level proxy (e.g. a shared Caddy on the VPS), keep the client
	# address it forwards; the backend's rate limit counts per client. Only
	# private networks are trusted, so a client on the internet cannot set it.
	servers {
		trusted_proxies static private_ranges
	}
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:3001
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# circuit files are large and change only with a new deployment
	@circuits path /circuits/*
	header @circuits Cache-Control "public, max-age=86400"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
