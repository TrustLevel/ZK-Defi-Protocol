# Settings for deploy/docker-compose.yml. Copy to deploy/.env; never commit the real file.

# Blockfrost project id for Preprod (free at https://blockfrost.io)
PREPROD_BLOCKFROST_API_KEY=preprod_your_project_id

# 24-word mnemonic of the relayer wallet. It pays the fees of borrow and unlock
# (about 1 ADA each) and needs a few pure-ADA outputs for script collateral.
# Use a wallet only for this, with a small amount of test ADA from the faucet.
# Without it the backend runs, but borrow and unlock are off.
RELAYER_WALLET_SEED=word1 word2 word3 ...

# Where the site is reachable. A domain gives automatic HTTPS (then set
# HTTP_PORT=80 and HTTPS_PORT=443); ":80" serves plain HTTP for local use.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# "off" turns the anonymous usage counters off
# ANALYTICS_FILE=off
