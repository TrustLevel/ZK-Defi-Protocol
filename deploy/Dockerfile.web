# M4 web app: built as static files (all proving happens in the browser) and
# served by Caddy, which also forwards /api to the backend.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY packages/protocol/package.json packages/protocol/package-lock.json packages/protocol/
RUN cd packages/protocol && npm ci --omit=dev
COPY web/package.json web/package-lock.json web/
RUN cd web && npm ci

COPY packages/protocol packages/protocol
COPY contracts/plutus.json contracts/
COPY circuits circuits
COPY web web
RUN cd web && npm run build

FROM caddy:2.8-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/web/out /srv
