# ==============================================================================
# ZK-DeFi Protocol - Master .gitignore
# ==============================================================================

# ==============================================================================
# Environment & Secrets (CRITICAL!)
# ==============================================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# ...but keep the sanitized template
!.env.example

# Admin wallet credentials
admin-wallet.json
*.skey
*.vkey
*.addr
*.key
*.priv

# User secrets for anonymous borrowing
secrets.json
.data/
borrow-request.json
borrow-request-*.json
requests/

# ==============================================================================
# Dependencies
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ==============================================================================
# Circuits (ZK Proofs)
# ==============================================================================

# Compiled circuit artifacts (auto-generated by circom)
circuits/*_js/
circuits/**/*.wasm
circuits/**/*.r1cs
circuits/**/*.sym
circuits/**/build/

# Trusted Setup Keys (LARGE FILES!)
circuits/keys/*.ptau
circuits/keys/*.zkey
# Note: verification_key.json is committed (small and needed for verification)

# Circuit test artifacts
circuits/tests/*.wtns
circuits/tests/*.json
!circuits/tests/README.md
circuits/tests/proof.json
circuits/tests/public.json
circuits/tests/input_test.json
circuits/tests/witness.wtns

# ==============================================================================
# Offchain Module (restructured 2026-01-27)
# ==============================================================================

# Deployed contract data
offchain/data/
offchain/onchain/

# Proof outputs
offchain/backend/proofs/
offchain/backend/proving-service/proofs/
*.proof.json
*.public.json
*.witness.wtns

# Build artifacts
offchain/backend/build/
offchain/backend/dist/
offchain/test-outputs/

# Fresh UI build directory
offchain/ui/_fresh/

# Receipts (contain secrets!)
offchain/.data/
offchain/receipts/
receipts/

# ==============================================================================
# Contracts (Aiken)
# ==============================================================================
contracts/artifacts/
contracts/build/
contracts/docs/
# Note: plutus.json is committed (needed for offchain integration)

# ==============================================================================
# IDE & System Files
# ==============================================================================
.DS_Store
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
*.tmp
*.temp
.cache/

# ==============================================================================
# Documentation (Optional - uncomment if you want to ignore docs)
# ==============================================================================
/docs/*
# ...but keep the published Milestone 3 evidence docs (required deliverables)
!/docs/MILESTONE3.md
!/docs/MILESTONE3-TEST-RESULTS.md
!/docs/MILESTONE3-EVIDENCE.md
!/docs/Tester-Feedback/
# ...and the approved M1/M2 POAs + the privacy/pivot response (reviewer-requested)
!/docs/poa/
!/docs/PRIVACY-AND-PIVOT.md

# Circomlib (install via npm or git clone)
circuits/circomlib/
circuits/node_modules/
circuits/collateral_proof_final.zkey
# Note: verification_key.json is committed (small and needed for verification)

# M3 reproducibility: commit the compiled circuit + proving key so the gate test
# runs turnkey (npm install && npm test) and verifies against the deployed vkey.
!circuits/collateral_proof_js/
!circuits/collateral_proof_js/collateral_proof.wasm
!circuits/keys/collateral_proof_final.zkey
# v6 privacy circuit (Merkle membership + nullifier) — same turnkey policy
!circuits/collateral_semaphore_js/
!circuits/collateral_semaphore_js/collateral_semaphore.wasm
!circuits/keys/collateral_semaphore_final.zkey
# v6 settlement circuit (commitment + repaid-set membership) — retires unlock_proof;
# unlock now proves settlement in ZK without revealing any borrow-shared value (Leak-2 fix)
!circuits/settlement_proof_js/
!circuits/settlement_proof_js/settlement_proof.wasm
!circuits/keys/settlement_proof_final.zkey
# v6 append circuit (permissionless self-append of R into repaid_root at repay)
!circuits/append_proof_js/
!circuits/append_proof_js/append_proof.wasm
!circuits/keys/append_proof_final.zkey

# Local dev instructions — kept locally, not published to the public repo
/CLAUDE.md
