test borrow_proof_verifies_onchain() {
  verify_borrow_proof(
    vkey(),
    proof(),
    17323061585773357565755602457575468163084897977630616152577448500835305461396,
    13363567938272564440676172658199675024663324988111273564368569843933911498447,
    7777,
    20087803399053417886222481829544038541141401726598857927096807636670,
  )
}

test tampered_borrow_signal_fails_onchain() {
  // Another loan nullifier than the one the proof binds -> rejected.
  !verify_borrow_proof(
    vkey(),
    proof(),
    17323061585773357565755602457575468163084897977630616152577448500835305461396,
    13363567938272564440676172658199675024663324988111273564368569843933911498448,
    7777,
    20087803399053417886222481829544038541141401726598857927096807636670,
  )
}

test tampered_recipient_signal_fails_onchain() {
  // A copied proof re-targeted at another payout key no longer verifies.
  !verify_borrow_proof(
    vkey(),
    proof(),
    17323061585773357565755602457575468163084897977630616152577448500835305461396,
    13363567938272564440676172658199675024663324988111273564368569843933911498447,
    7777,
    20087803399053417886222481829544038541141401726598857927096807636671,
  )
}

