test append_d_verifies_onchain() {
  // A real proof on its own terms; pairing it with loan A's repay is what fails.
  verify_append_proof(
    append_vkey(),
    append_proof_d(),
    13916937046501108967048154641689659101970478684843793251827738918983778486795,
    10872960336090883658176298111607344105867080973375616068841706623573100676638,
    7105608934630822492929134765106035351468175385450393321332253277479325408771,
    0,
  )
}

test tampered_append_signal_fails_onchain() {
  // Tamper the new_root public signal (+1) -> the claimed insertion no longer holds.
