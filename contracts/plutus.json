    "types_v5/CollateralRedeemerV5": {
      "title": "CollateralRedeemerV5",
      "description": "Collateral redeemer (v6). Unlock spends the deposit with a settlement proof\n (commitment-bound + Merkle membership of the private R in the pool's\n `repaid_root`, read via pool_ref). Carries NO borrow-shared value.",
