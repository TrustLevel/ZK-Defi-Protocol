              "$ref": "#/definitions/Option$Int"
            }
          ]
        }
      ]
    },
    "types_v5/PoolDatumV5": {
      "title": "PoolDatumV5",
      "description": "Lending pool datum (v5/v6).\n `collateral_ratio` is the protocol LTV ratio used as a ZK public signal.\n `vkey_ref` pins the reference UTxO that holds the trusted SnarkVerificationKey.\n `open_loans_root` is the MPF root of currently-outstanding loan nullifiers\n (reserved for the global double-borrow guard; preserved on every branch until\n Workstream C wires the MPF insert/delete).",
