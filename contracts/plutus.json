    "types_v5/CollateralRedeemerV5": {
      "title": "CollateralRedeemerV5",
      "description": "Collateral redeemer (v5/v6).\n - UsedAsCollateral locks the collateral to a loan (loan_bound None -> Some(n)).\n - SettleLoan frees it (Some(n) -> None) and requires the pool to be repaying\n   the same loan in this transaction.\n - UnlockDeposit spends the freed collateral, authorized by a ZK ownership\n   proof verified against the pool's trusted vkey (read via pool_ref).",
      "anyOf": [
        {
          "title": "Withdraw",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "UsedAsCollateral",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "loan_nullifier",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "SettleLoan",
          "dataType": "constructor",
          "index": 2,
          "fields": [
            {
              "title": "loan_nullifier",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "UnlockDeposit",
          "dataType": "constructor",
          "index": 3,
          "fields": [
            {
              "title": "proof",
              "$ref": "#/definitions/ak_381~1groth16~1Proof"
            },
            {
              "title": "pool_ref",
              "$ref": "#/definitions/cardano~1transaction~1OutputReference"
            }
          ]
        }
      ]
    },
    "types_v5/DepositDatumV5": {
      "title": "DepositDatumV5",
      "description": "Collateral deposit datum (v5/v6).\n `commitment` = Poseidon255(collateral_amount, secret) as a BLS12-381 field\n element, stored as Int so it can be passed straight to groth_verify.\n `loan_bound`: None = free to unlock/withdraw; Some(loan_nullifier) = currently\n backing an outstanding loan and therefore locked until that loan is settled.",
      "anyOf": [
        {
          "title": "DepositDatumV5",
          "dataType": "constructor",
          "index": 0,
          "fields": [
