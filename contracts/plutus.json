    "types_v5/DepositDatumV5": {
      "title": "DepositDatumV5",
      "description": "Collateral deposit datum (v6). No amount — the commitment (Merkle leaf =\n Poseidon255(collateral_amount, secret)), a timestamp, and `unlock_to`: the\n address the collateral is paid to on unlock. Fixing the recipient at deposit\n means a copied unlock proof cannot redirect the collateral (front-running);\n it reveals nothing new, since unlock spends this very deposit anyway.",
      "anyOf": [
        {
          "title": "DepositDatumV5",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "commitment",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "timestamp",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "unlock_to",
              "$ref": "#/definitions/cardano~1address~1Address"
            }
          ]
        }
      ]
    },
    "types_v5/PoolDatumV5": {
      "title": "PoolDatumV5",
      "description": "Lending pool datum (v6). The pool UTxO carries the one-shot pool NFT; the\n verification keys are validator parameters, not datum fields.\n `group_root`          -> append-only Merkle root of the collateral commitment\n                          set; grown PERMISSIONLESSLY by DepositCollateral via\n                          a ZK append proof (no admin)\n `group_next_index`    -> next free leaf position in the group_root tree\n `repaid_root`         -> append-only Merkle root of repayment nullifiers R;\n                          grown PERMISSIONLESSLY by Repay via a ZK append proof\n                          (no admin), so unlock can prove settlement in zero knowledge\n `next_index`          -> next free leaf position in the repaid_root tree\n `external_nullifier`  -> fixed protocol constant scoping loan nullifiers\n `repay_external_nullifier` -> DISTINCT protocol constant scoping repayment\n                          nullifiers, so R cannot be correlated with the\n                          borrow-time loan_nullifier\n `collateral_denomination` -> every collateral deposit is exactly this many\n                          lovelace (checked on-chain at DepositCollateral);\n                          Borrow checks it covers loan_denomination at the ratio\n `loan_denomination`   -> every loan is exactly this size, so loan amounts are\n                          uniform (carry no per-loan information) and open_loans\n                          need only store nullifiers, not principals.\n `open_loans`          -> outstanding loan nullifiers (what Repay may settle)\n `used_nullifiers`     -> every loan nullifier ever borrowed against; never\n                          shrinks, so one deposit backs exactly ONE loan and a\n                          repaid deposit's R can never cover a later loan",
      "anyOf": [
        {
          "title": "PoolDatumV5",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "total_deposited",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "total_borrowed",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "interest_rate",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "collateral_ratio",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "group_root",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "group_next_index",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "repaid_root",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "next_index",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "external_nullifier",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "repay_external_nullifier",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "collateral_denomination",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "loan_denomination",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "open_loans",
              "$ref": "#/definitions/List$Int"
            },
            {
              "title": "used_nullifiers",
              "$ref": "#/definitions/List$Int"
            },
            {
              "title": "last_updated",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "types_v5/PoolRedeemerV5": {
      "title": "PoolRedeemerV5",
      "description": "Lending pool redeemer (v6).\n `AddLiquidity`: lender adds lovelace to the pool.\n `DepositCollateral`: a collateral output of exactly `collateral_denomination`\n with this `commitment` is created, and `append_proof` attests the commitment\n is appended at `group_next_index`, taking group_root -> out.group_root.\n `BorrowAnonymous`: the proof is bound to `recipient`; the loan must be paid\n to that key (front-running protection).\n `RepayAnonymous`: `proof` is a repay proof binding `loan_nullifier` AND\n `repay_nullifier` to one secret. `repay_nullifier` = R = Poseidon255(secret, repay_external_nullifier);\n `append_proof` attests R is appended at `next_index`, taking repaid_root ->\n out.repaid_root (permissionless — no admin signature on repay).",
      "anyOf": [
